{
  "name": "economic-docu-studio",
  "version": "0.1.0",
  "description": "경제·시사 뉴스 기반 롱폼 영상 자동 제작 프로그램 — 경제 주제 하나로 최신 뉴스 리서치, 대본, 실제 시각자료(사진/차트/그래프), 내레이션, 자막을 생성해 유튜브용 영상을 만듭니다.",
  "author": "video-pipeline",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.js",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "dist": "npm run build && electron-builder",
    "doctor": "node scripts/doctor.js",
    "capability": "node scripts/capability-check.js",
    "dry-run": "node scripts/dry-run.js",
    "test:scene": "node scripts/test-scene.js",
    "test:short": "node scripts/test-short.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "build": {
    "appId": "com.economicdocustudio.app",
    "productName": "경제다큐스튜디오",
    "asar": false,
    "files": [
      "main.js",
      "package.json",
      ".next/standalone/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "concurrently": "^10.0.4",
    "fluent-ffmpeg": "^2.1.3",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "@ffmpeg-installer/ffmpeg": true,
    "@ffprobe-installer/ffprobe": true,
    "electron-winstaller": true
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.3"
  }
}
